// Cloudflare Workers (static assets) — used while the app is hosted off Vercel.
// "npx wrangler deploy" uploads the Vite build in ./dist. Unknown paths serve
// index.html, the same as vercel.json's rewrite; public/_headers carries the
// cache rules. The name must match the Worker's project name in Cloudflare.
{
  "name": "information-systems-unlocked",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
